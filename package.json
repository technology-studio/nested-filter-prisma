{
  "name": "@txo/nested-filter-prisma",
  "version": "2.7.0",
  "description": "Technology Studio - Nested filter prisma",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/technology-studio/nested-filter-prisma.git"
  },
  "author": {
    "name": "Technology Studio",
    "email": "npm@technologystudio.sk",
    "url": "https://github.com/technology-studio/"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "build:clean": "yarn rimraf lib",
    "build:lib": "yarn tsc",
    "build:patch": "find lib -name '*.d.ts' -exec sed -i '' 's/\"Placeholder\"/Type/g' {} \\;",
    "build:watch": "yarn tsc --watch",
    "build": "yarn build:clean && yarn build:lib && yarn build:patch",
    "compare-boilerplate-version": "./scripts/compare-boilerplate-version.sh",
    "coverage": "jest --coverage && open coverage/lcov-report/index.html || xdg-open coverage/lcov-report/index.html",
    "lint:ci": "yarn lint",
    "lint:fix": "eslint . --fix",
    "lint": "eslint --max-warnings 0 .",
    "prepare": "husky && yarn build",
    "print-txo-packages": "yarn list 2> /dev/null|grep @txo|sed 's/.*\\(@txo[^@]*\\)@^*\\([^ ]*\\).*/\\1@\\2/g'|sort|uniq",
    "sanity": "yarn lint:ci && yarn build && tsc --noEmit && yarn test --coverage && yarn compare-boilerplate-version && echo 'success'",
    "semantic-release": "semantic-release",
    "test:watch": "concurrently \"yarn build:watch\" \"yarn test --watch\"",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "update-boilerplate-version": "./scripts/update-boilerplate-version.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@txo/log": "^2.0.16",
    "@txo/nexus-prisma": "^2.0.3",
    "@txo/prisma-graphql": "^1.0.0",
    "@txo/types": "^1.7.0",
    "lodash.get": "^4.4.2",
    "lodash.set": "^4.3.2"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@txo-peer-dep/log": "^4.0.4",
    "@txo-peer-dep/nested-filter-prisma": "^2.0.4",
    "@txo/commitlint": "^1.0.19",
    "@txo/log-console": "^3.0.0",
    "@txo/semantic-release": "^2.0.8",
    "@txo/tsconfig": "^1.1.1",
    "@types/jest": "^29.5.14",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.set": "^4.3.9",
    "concurrently": "^9.1.0",
    "eslint-config-txo-typescript": "^4.0.70",
    "graphql": "^16.9.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "npm-check-updates": "^17.1.11",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@txo-peer-dep/nested-filter-prisma": "^2.0.4"
  }
}
